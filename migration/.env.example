# Source database — the existing, live Egoola schema. Read-only: this tool
# never writes to it.
OLD_DB_HOST=127.0.0.1
OLD_DB_PORT=3306
OLD_DB_DATABASE=egoola_3
OLD_DB_USERNAME=root
OLD_DB_PASSWORD=

# Target database — an empty database for the redesigned schema. `--fresh`
# creates all 32 tables in it from database/new_schema/new_schema.sql.
NEW_DB_HOST=127.0.0.1
NEW_DB_PORT=3306
NEW_DB_DATABASE=egoola_new
NEW_DB_USERNAME=root
NEW_DB_PASSWORD=
